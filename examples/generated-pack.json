{
  "schemaVersion": 1,
  "name": "Generated distribution probe",
  "artifact": {
    "root": "./emitted",
    "packages": ["plugin"],
    "requiredFiles": [
      { "path": "plugin/plugin.json" },
      { "path": "plugin/skills/distribution-probe/SKILL.md" },
      { "path": "plugin/skills/distribution-probe/references/expected.md" },
      { "path": "plugin/com.openai/hooks.json" },
      { "path": "plugin/mcp.json" },
      { "path": ".agents/plugins/marketplace.json" },
      { "path": ".claude-plugin/marketplace.json" },
      { "path": "plugin/.claude-plugin/plugin.json" }
    ]
  },
  "cases": [
    {
      "id": "emitted-skill",
      "kind": "file",
      "path": "plugin/skills/distribution-probe/SKILL.md",
      "assert": [{ "type": "contains", "value": "distribution_echo" }]
    },
    {
      "id": "codex-native-discovery",
      "kind": "codex-discovery",
      "package": "plugin",
      "marketplace": ".agents/plugins/marketplace.json",
      "plugin": "distribution-probe",
      "assert": [
        { "type": "is-json" },
        {
          "type": "regex",
          "value": "\"skills\":\\[\\{\"name\":\"distribution-probe"
        },
        { "type": "contains", "value": "Complete Package Probe" }
      ]
    },
    {
      "id": "claude-native-discovery",
      "kind": "claude-discovery",
      "package": "plugin",
      "marketplace": ".claude-plugin/marketplace.json",
      "plugin": "distribution-probe",
      "assert": [
        { "type": "is-json" },
        {
          "type": "contains",
          "value": "\"name\":\"distribution-probe:distribution-probe\""
        },
        {
          "type": "contains",
          "value": "\"name\":\"plugin:distribution-probe:distribution-probe\""
        }
      ]
    }
  ]
}
