      "plugin": "dotfiles",
      "executable": "/nix/store/9ifcrbvdzh7x23whvi876d87rrxi6m4b-codex-0.155.1/bin/codex",
      "server": "sonarqube",
      "tool": "list_languages",
      "arguments": {
        "q": "python"
      },
      "assert": [
        {
          "type": "regex",
          "value": "\"structuredContent\":\\{\"languages\":\\[[^\\]]*\\{\"key\":\"py\",\"name\":\"Python\"\\}"
        },
        {
          "type": "contains",
          "value": "\"isError\":false"
        }
      ],
      "disabledServers": ["chrome-devtools"]
    },
    {
