{
  "name": "verdr",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Evaluate the agent artifacts people actually install",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "bin": {
    "verdr": "dist/cli.js"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"for(const file of ['probe.py','mcp.py'])require('node:fs').copyFileSync('src/native/hermes/'+file,'dist/native/hermes/'+file)\"",
    "test": "node --import tsx --test test/*.test.ts",
    "test:native": "node --import tsx --test --test-concurrency=1 test/native/*.integration.ts",
    "check": "tsc --noEmit && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "ajv": "8.20.0",
    "promptfoo": "0.122.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.280",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@types/node": "22.20.3",
    "opencode-ai": "1.18.32",
    "pi-agent-plugins": "0.1.8",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
}
